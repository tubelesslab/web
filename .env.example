# Copie para .dev.vars (Cloudflare/OpenNext) e/ou .env.local. Nunca versione os valores reais.
# Em producao: Cloudflare > Settings > Variables and Secrets, todas como Secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SESSION_SECRET=
# Meta Pixel (publico, nao e segredo). NEXT_PUBLIC_* entra no build: defina em .env.local/.env.production ou nas Build variables do Cloudflare.
NEXT_PUBLIC_META_PIXEL_ID=
